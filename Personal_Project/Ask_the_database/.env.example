# Reference only: this project reads environment variables, it does not load .env files.
# Set them in your shell (see README). NEVER commit a real key.

# Which AI to use: gemini (free tier) | ollama (free, local) | anthropic (paid)
ASK_DB_PROVIDER=gemini

# Keys, only for the provider(s) you use. Ollama needs none.
GEMINI_API_KEY=your-gemini-key        # free: https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=your-claude-key     # paid: https://platform.claude.com

# Optional
# ASK_DB_MODEL_GEMINI=gemini-3.5-flash       # list valid names: python -m src.llm --list-models gemini
# ASK_DB_MODEL_OLLAMA=qwen2.5-coder:7b       # list installed:    python -m src.llm --list-models ollama
# ASK_DB_MODEL_ANTHROPIC=claude-haiku-5-5
# OLLAMA_HOST=http://localhost:11434
# ASK_DB_TEMPERATURE=0                       # more repeatable eval runs
# ASK_DB_PROMPT=v2
# ASK_DB_PATH=db/resort.db
