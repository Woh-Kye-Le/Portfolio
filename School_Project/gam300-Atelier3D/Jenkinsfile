// Atelier3D CI pipeline
// Builds the desktop app (CMake project in apps/desktop) on every change to main and reports failures.
pipeline {
    // Runs on the Ubuntu Jenkins node. The Install Dependencies stage installs the tools it needs
    // (tools/ci/install-deps.sh), which needs root or passwordless sudo for apt-get the first time.
    // Jenkins plugins: Pipeline, Git, GitHub, Timestamper, JUnit, Warnings (warnings-ng)
    // Must run on the Jenkins controller (built-in node): Publish Downloads writes to $JENKINS_HOME/userContent
    agent any

    environment {
        // The integration branch: every build checks out its latest commit
        INTEGRATION_BRANCH = 'main'
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
        // A build with a full clang-tidy run and cold compile caches takes about 1h45; this only catches a stuck build
        timeout(time: 180, unit: 'MINUTES')
    }

    triggers {
        // Builds as soon as GitHub reports a push, once the repository has a webhook to <jenkins>/github-webhook/
        // (Settings > Webhooks, content type application/json, "Just the push event")
        githubPush()
        // Fallback when the webhook cannot reach Jenkins: checks GitHub for new commits every ~5 minutes
        pollSCM('H/5 * * * *')
        // Nightly full clang-tidy run: pushes only lint what they changed (see the Checkout and Lint stages)
        cron('H 3 * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                // Always the integration branch, whatever branch the job's own settings name; the job's repository
                // URL and credentials are reused. Polling and push triggers watch the branch checked out here.
                script {
                    def scmVars = checkout([$class: 'GitSCM',
                                            branches: [[name: "*/${env.INTEGRATION_BRANCH}"]],
                                            userRemoteConfigs: scm.userRemoteConfigs,
                                            extensions: scm.extensions])
                    // Pushes lint the changes since the last successful build, so a change in a failed build is linted
                    // again. Nightly and manual builds, and a job with no successful build yet, lint everything (no base).
                    def fullLint = currentBuild.getBuildCauses('hudson.triggers.TimerTrigger$TimerTriggerCause') ||
                                   currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause')
                    env.LINT_BASE = fullLint ? '' : (scmVars.GIT_PREVIOUS_SUCCESSFUL_COMMIT ?: '')
                }
                sh 'echo "Building $INTEGRATION_BRANCH at $(git log -1 --oneline)"'
            }
        }

        stage('Install Dependencies') {
            steps {
                // Installs any missing build tools and headers; changes nothing on a ready node
                sh 'bash tools/ci/install-deps.sh'
            }
        }

        stage('Build Linux (Debug)') {
            steps {
                sh 'bash tools/ci/build.sh Debug linux'
            }
        }

        stage('Unit Tests') {
            steps {
                // GoogleTest suite in tests/unit; any failing test fails the build
                sh 'bash tools/ci/test.sh Debug'
            }
        }

        stage('Lint') {
            steps {
                // clang-format (code style, .clang-format) and clang-tidy (code lint, .clang-tidy) on our code;
                // fails on unformatted files or bugprone/analyzer findings, reports the rest
                // With a LINT_BASE, clang-tidy only checks what changed since it and the files that include a change
                sh 'bash tools/ci/lint.sh Debug "${LINT_BASE:-}"'
            }
        }

        stage('Static Analysis') {
            steps {
                // cppcheck on our code; fails on "error" severity, reports the rest
                sh 'bash tools/ci/static-analysis.sh'
            }
        }

        // The nightly build is only for the full lint: it stops here, so it adds no public downloads
        stage('Build Linux (Release)') {
            when { not { triggeredBy 'TimerTrigger' } }
            steps {
                sh 'bash tools/ci/build.sh Release linux'
            }
        }

        stage('Build Windows (Release)') {
            when { not { triggeredBy 'TimerTrigger' } }
            steps {
                // Cross-compiles native Windows .exe files with MinGW-w64
                sh 'bash tools/ci/build.sh Release windows'
            }
        }

        stage('Package') {
            when { not { triggeredBy 'TimerTrigger' } }
            steps {
                sh 'bash tools/ci/package.sh Release linux'
                sh 'bash tools/ci/package.sh Release windows'
                // Downloadable from the build page under "Build Artifacts" (team only: needs Job/Read)
                archiveArtifacts artifacts: 'apps/desktop/build/dist/*.tar.gz, apps/desktop/build/dist/*.zip', fingerprint: true
            }
        }

        stage('Publish Downloads') {
            when { not { triggeredBy 'TimerTrigger' } }
            steps {
                // Public downloads for guests, who only need Overall/Read (no Job/Read, so no job page,
                // stage view or trends): <jenkins>/userContent/atelier3d/ (history page with download links)
                sh 'bash tools/ci/publish-downloads.sh "$JENKINS_HOME/userContent/atelier3d" "$BUILD_NUMBER"'
            }
        }
    }

    post {
        always {
            // Test results: "Test Result" page and trend chart on the job page
            junit testResults: 'apps/desktop/build/reports/tests-*.xml', allowEmptyResults: true

            // Compiler warnings (from the console log), cppcheck, clang-tidy and clang-format findings:
            // "GCC Warnings", "CPPCheck Warnings", "Clang-Tidy Warnings" and "clang-format" pages (each with its own
            // trend chart), plus one combined trend chart on the job page so the Stage View stays near the top.
            // Third-party code (FetchContent's _deps/ and apps/desktop/libraries/) is left out of every page.
            recordIssues enabledForFailure: true,
                         trendChartType: 'AGGREGATION_ONLY',
                         tools: [gcc(), cppCheck(pattern: 'apps/desktop/build/reports/cppcheck.xml'),
                                 clangTidy(pattern: 'apps/desktop/build/reports/clang-tidy.txt'),
                                 clang(pattern: 'apps/desktop/build/reports/clang-format.txt', id: 'clang-format', name: 'clang-format')],
                         filters: [excludeFile('.*/_deps/.*'), excludeFile('(.*/)?apps/desktop/libraries/.*')]

            // Public build history (every build, pass or fail); never fails the build itself
            sh "bash tools/ci/publish-history.sh \"\$JENKINS_HOME/userContent/atelier3d\" \"\$BUILD_NUMBER\" ${currentBuild.currentResult} " +
               "|| echo 'WARNING: could not update the public build history'"
        }
        success {
            echo "BUILD PASSED: ${env.JOB_NAME} #${env.BUILD_NUMBER}"
        }
        failure {
            echo "BUILD FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER} - see ${env.BUILD_URL}console"
            // Optional: uncomment once SMTP is set up in Manage Jenkins > System
            // mail to: 'team@example.com',
            //      subject: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
            //      body: "Build failed on main. Console log: ${env.BUILD_URL}console"
        }
    }
}
