# Lint rules for our own C++ code (everything under apps/ except the third-party apps/desktop/libraries/)
# Checked in CI by tools/ci/lint.sh
#   performance-unnecessary-value-param is off: clang-tidy 21 crashes in it on GCC 15's <functional>
#   clang-analyzer-optin.performance.Padding is off: it suggests reordering class members to save memory, not a bug
#   bugprone-* and clang-analyzer-* are treated as errors (likely bugs) and fail the build;
#   the other checks are reported as warnings on the "Clang-Tidy Warnings" page in Jenkins
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  -clang-analyzer-optin.performance.Padding,
  performance-*,
  -performance-unnecessary-value-param,
  modernize-use-override,
  modernize-use-nullptr,
  modernize-use-emplace,
  modernize-loop-convert,
  modernize-make-unique,
  modernize-make-shared,
  readability-container-size-empty,
  readability-redundant-string-cstr,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-braces-around-statements,
  misc-redundant-expression,
  misc-unused-using-decls,
  misc-definitions-in-headers
WarningsAsErrors: 'bugprone-*,clang-analyzer-*'
# Report findings in headers under apps/; tools/ci/lint.sh then drops any in apps/desktop/libraries/ and
# apps/desktop/build/ (third-party code), which this regex cannot exclude
HeaderFilterRegex: '.*/apps/.*'
FormatStyle: file
